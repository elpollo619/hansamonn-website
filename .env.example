# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and should never be committed.

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX)
# Get yours at https://analytics.google.com
VITE_GA_ID=G-XXXXXXXXXX

# Optional: AI mode of the website chat (api/assistant.js, Claude by Anthropic).
# Server-side only: set it in Vercel → Project → Settings → Environment Variables,
# never with a VITE_ prefix (that would publish it in the browser bundle).
# Without it the chat keeps answering from the website's own facts in the browser.
ANTHROPIC_API_KEY=
